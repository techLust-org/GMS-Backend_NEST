PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_management
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

FRONTEND_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
AWS_BUCKET_NAME=your_s3_bucket_name

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=no-reply@example.com

# Firebase service account (Firebase console > Project settings > Service accounts
# > Generate new private key). Push notifications are skipped gracefully if unset.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials).
# Comma-separated if Android/iOS/Web each have their own OAuth client ID —
# all are accepted as valid token audiences. "Sign in with Google" fails
# with a clear error until this is set.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# WhatsApp OTP (Meta WhatsApp Cloud API — Meta for Developers > your app >
# WhatsApp > API Setup). WHATSAPP_OTP_TEMPLATE_NAME must be a message
# template you've created and had approved in WhatsApp Manager under the
# "Authentication" category (a single {{1}} body placeholder for the code).
# Outside NODE_ENV=production, if these are unset (or sending fails) the
# generated code is returned directly in the API response so the flow can
# still be tested end-to-end without a working WhatsApp integration.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
